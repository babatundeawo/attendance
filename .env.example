# Firebase web app configuration (Firebase console > Project settings > General > Your apps).
# These values identify your project; they are not passwords. In production they are
# injected by GitHub Actions from repository secrets, so this file is only a reference.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
