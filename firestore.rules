rules_version = '2';

// Attendance Register security rules.
// Everything is denied unless a rule below allows it. Only people listed in the
// "staff" collection (one document per person, named after their sign-in user ID)
// can read or change anything.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function isDateId(id) {
      return id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // A signed-in person may check whether their own staff entry exists.
    // Nobody can create or edit staff entries from the app; the administrator
    // does that in the Firebase console.
    match /staff/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /students/{studentId} {
      allow read, delete: if isStaff();
      allow create, update: if isStaff()
        && request.resource.data.keys().hasOnly(
             ['name', 'gender', 'order', 'admissionNo', 'dob', 'parentName', 'address', 'phone', 'religion'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.gender in ['M', 'F']
        && request.resource.data.order is number
        && request.resource.data.get('admissionNo', '') is string
        && request.resource.data.get('dob', '') is string
        && request.resource.data.get('parentName', '') is string
        && request.resource.data.get('address', '') is string
        && request.resource.data.get('phone', '') is string
        && request.resource.data.get('religion', '') is string;
    }

    // One document per date (YYYY-MM-DD) holding each student's AM/PM marks.
    match /attendance/{dateId} {
      allow read, delete: if isStaff() && isDateId(dateId);
      allow create, update: if isStaff() && isDateId(dateId);
    }

    match /holidays/{dateId} {
      allow read, delete: if isStaff() && isDateId(dateId);
      allow create, update: if isStaff() && isDateId(dateId)
        && request.resource.data.keys().hasOnly(['label'])
        && request.resource.data.label is string
        && request.resource.data.label.size() <= 120;
    }

    // Anything not listed above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
